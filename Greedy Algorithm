import heapq
import math

# Posisyon (x, y) ng bawat node
positions = {
    'A': (0, 0),
    'B': (2, 1),
    'C': (2, -1),
    'D': (4, 2),
    'E': (4, 0),
    'F': (4, -2),
    'G': (6, 0),
}

# May bigat (cost) na mga koneksyon: node -> {kapitbahay: cost}
graph = {
    'A': {'B': 2.5, 'C': 3},
    'B': {'A': 2.5, 'D': 3, 'E': 3},
    'C': {'A': 3, 'E': 3, 'F': 4},
    'D': {'B': 3, 'E': 2, 'G': 4},
    'E': {'B': 3, 'C': 3, 'D': 2, 'G': 3},
    'F': {'C': 4, 'G': 3},
    'G': {'D': 4, 'E': 3, 'F': 3},
}

# Heuristic: tuwid na distansya papunta sa goal
def heuristic(node, goal):
    x1, y1 = positions[node]
    x2, y2 = positions[goal]
    return math.hypot(x2 - x1, y2 - y1)

# Buuin ang path mula sa came_from (pabalik mula goal papuntang start)
def build_path(came_from, goal):
    path = []
    node = goal
    while node is not None:
        path.append(node)
        node = came_from[node]
    return path[::-1]

def greedy(graph, start, goal):
    counter = 0
    open_set = [(heuristic(start, goal), counter, start)]
    came_from = {start: None}                     # isang beses lang makikita ang bawat node
    explored = []

    while open_set:
        _, _, current = heapq.heappop(open_set)   
        explored.append(current)

        if current == goal:
            path = build_path(came_from, goal)
            # i solve ang totoong cost ng nahanap na path
            cost = sum(graph[a][b] for a, b in zip(path, path[1:]))
            return path, cost, explored

        for neighbor in graph[current]:
            if neighbor not in came_from:
                came_from[neighbor] = current
                counter += 1
                heapq.heappush(open_set, (heuristic(neighbor, goal), counter, neighbor))

    return None, float('inf'), explored


if __name__ == "__main__":
    start, goal = 'A', 'G'
    path, cost, explored = greedy(graph, start, goal)

    print("=== Greedy Best-First ===")
    print("Path           :", " -> ".join(path))
    print("Total cost     :", cost)
    print("Nodes explored :", len(explored))
    print("Explored order :", " ".join(explored))

    
