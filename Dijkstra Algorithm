import heapq

# May bigat (cost) na mga koneksyon: node -> {kapitbahay: cost}
graph = {
    'A': {'B': 2.5, 'C': 3},
    'B': {'A': 2.5, 'D': 3, 'E': 3},
    'C': {'A': 3, 'E': 3, 'F': 4},
    'D': {'B': 3, 'E': 2, 'G': 4},
    'E': {'B': 3, 'C': 3, 'D': 2, 'G': 3},
    'F': {'C': 4, 'G': 3},
    'G': {'D': 4, 'E': 3, 'F': 3},
}

# Buuin ang path mula sa came_from (pabalik mula goal papuntang start)
def build_path(came_from, goal):
    path = []
    node = goal
    while node is not None:
        path.append(node)
        node = came_from[node]
    return path[::-1]

def dijkstra(graph, start, goal):
    counter = 0                                   
    open_set = [(0, counter, start)]
    g_score = {start: 0}                          # pinakamurang cost papunta sa bawat node
    came_from = {start: None}
    closed = set()
    explored = []                                 # listahan ng na-explore na nodes

    while open_set:
        _, _, current = heapq.heappop(open_set)   # pinakamababang g(n) ang kinukuha
        if current in closed:
            continue
        closed.add(current)
        explored.append(current)

        if current == goal:                       # nakarating na sa goal
            return build_path(came_from, goal), g_score[goal], explored

        for neighbor, cost in graph[current].items():
            new_g = g_score[current] + cost
            if neighbor not in g_score or new_g < g_score[neighbor]:
                g_score[neighbor] = new_g
                came_from[neighbor] = current
                counter += 1
                heapq.heappush(open_set, (new_g, counter, neighbor))

    return None, float('inf'), explored


if __name__ == "__main__":
    start, goal = 'A', 'G'
    path, cost, explored = dijkstra(graph, start, goal)

    print("=== Dijkstra ===")
    print("Path           :", " -> ".join(path))
    print("Total cost     :", cost)
    print("Nodes explored :", len(explored))
    print("Explored order :", " ".join(explored))
